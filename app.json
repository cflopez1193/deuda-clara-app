{
  "expo": {
    "name": "Deuda Clara",
    "slug": "deuda-clara",
    "version": "1.4.0",
    "description": "Tus deudas, con claridad. Registra, diagnostica y planifica tu salida de deudas.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deudaclara",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.deudaclara.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.deudaclara.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B2B26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2B26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DeudaClara",
              "label": "Deuda Clara",
              "description": "Gasto, ingreso y crédito rápido. Tus prestamistas, a un toque.",
              "minWidth": "300dp",
              "minHeight": "200dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/deuda-clara.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5903547c-10d1-437a-b0c6-78e4dfb5d942"
      }
    },
    "owner": "clopez0322"
  }
}
