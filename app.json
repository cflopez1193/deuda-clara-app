{
  "expo": {
    "name": "Deuda Clara",
    "slug": "deuda-clara",
    "version": "1.0.0",
    "description": "Tus deudas, con claridad. Registra, diagnostica y planifica tu salida de deudas.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deudaclara",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.deudaclara.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.deudaclara.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B2B26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2B26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
